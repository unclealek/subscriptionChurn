subscriptionChurn:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: "{{ env_var('DBT_CATALOG', 'transform') }}"
      schema: "{{ env_var('DBT_SCHEMA', 'dbt_silver') }}"
      host: "{{ env_var('DATABRICKS_HOST', 'https://example.cloud.databricks.com') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH', '/sql/1.0/warehouses/example') }}"
      token: "{{ env_var('DATABRICKS_TOKEN', 'dummy-token') }}"
      threads: 4

    prod:
      type: databricks
      catalog: "{{ env_var('DBT_CATALOG', 'transform') }}"
      schema: "{{ env_var('DBT_SCHEMA', 'dbt_silver') }}"
      host: "{{ env_var('DATABRICKS_HOST', 'https://example.cloud.databricks.com') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH', '/sql/1.0/warehouses/example') }}"
      token: "{{ env_var('DATABRICKS_TOKEN', 'dummy-token') }}"
      threads: 4
